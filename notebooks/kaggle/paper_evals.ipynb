   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Paper Evaluations — CIs, Calibration, Robustness, Per-Generator (Kaggle)\n",
    "Loads the best MFFT checkpoint from HF and produces:\n",
    "1. Bootstrap 95% confidence intervals\n",
    "2. Temperature scaling (pre/post ECE, Brier)\n",
    "3. Robustness suite (JPEG / downscale / blur)\n",
    "4. Per-generator accuracy breakdown\n",
    "\n",
    "**Prerequisite:** `train_mfft_base.ipynb` must have completed."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 1: Clone repo & install deps\n",
    "import subprocess, sys, shutil\n",
    "from pathlib import Path\n",
    "\n",
    "REPO_DIR = Path(\"/kaggle/working/mfft_repo\")\n",
    "if REPO_DIR.exists():\n",
    "    shutil.rmtree(REPO_DIR)\n",
    "subprocess.run([\"git\", \"clone\", \"https://github.com/MIHMahmudEli/ai-image-detection-research.git\", str(REPO_DIR)], check=True)\n",
    "sys.path.insert(0, str(REPO_DIR))\n",
    "subprocess.run([\"pip\", \"install\", \"-q\", \"huggingface_hub\", \"open_clip_torch\", \"scipy\", \"python-dotenv\"], check=False)\n",
    "print(\"Ready.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 2: Setup\n",
    "import os, json, time\n",
    "from pathlib import Path\n",
    "import torch\n",
    "import torch.nn.functional as F\n",
    "import numpy as np\n",
    "\n",
    "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "print(f\"GPU: {torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'NONE'}\")\n",
    "\n",
    "try:\n",
    "    from kaggle_secrets import UserSecretsClient\n",
    "    hf_token = UserSecretsClient().get_secret(\"HF_TOKEN\")\n",
    "except Exception:\n",
    "    hf_token = os.environ.get(\"HF_TOKEN\")\n",
    "print(f\"HF Token: {hf_token[:8]}...\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 3: Load manifest & create DataLoaders\n",
    "from split_manifest_manager import SplitManifestManager\n",
    "from kaggle_dataset_loader import KaggleDatasetLoader\n",
    "\n",
    "manifest_mgr = SplitManifestManager(hf_token=hf_token, run_id=\"paper_evals\")\n",
    "manifest, manifest_sha256 = manifest_mgr.download()\n",
    "\n",
    "loader = KaggleDatasetLoader(\n",
    "    manifest=manifest, manifest_sha256=manifest_sha256,\n",
    "    input_root=\"/kaggle/input\", image_size=224,\n",
    ")\n",
    "train_loader, val_loader, test_loader = loader.create_dataloaders(batch_size=64, num_workers=4)\n",
    "print(f\"Test: {len(loader.test_data)} images\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 4: Load best MFFT-Base checkpoint from HF\n",
    "sys.path.insert(0, str(REPO_DIR / \"model\"))\n",
    "from src.model import build_mfft\n",
    "\n",
    "model = build_mfft(\"base").to(device)\n",
    "\n",
    "# Find the best run's best checkpoint\n",
    "from huggingface_hub import hf_hub_download\n",
    "try:\n",
    "    path = hf_hub_download(\n",
    "        repo_id=\"MohsinElis/mfft-checkpoints\",\n",
    "        filename=\"runs/mfft-base_kaggle_*/checkpoints/best.pt\",  # glob pattern\n",
    "        repo_type=\"model\", token=hf_token,\n",
    "    )\n",
    "    ckpt = torch.load(path, map_location=device)\n",
    "    model.load_state_dict(ckpt[\"model_state_dict\"])\n",
    "    print(f\"Loaded checkpoint from {path}\")\n",
    "except Exception as e:\n",
    "    # Fallback: try last.pt from any base run\n",
    "    print(f\"Could not find best.pt, trying last.pt: {e}\")\n",
    "    from huggingface_hub import HfApi\n",
    "    api = HfApi(token=hf_token)\n",
    "    files = list(api.list_repo_files(repo_id=\"MohsinElis/mfft-checkpoints\", repo_type=\"model\"))\n",
    "    base_runs = [f for f in files if \"mfft-base\" in f and f.endswith(\"checkpoints/last.pt\")]\n",
    "    if base_runs:\n",
    "        path = hf_hub_download(\n",
    "            repo_id=\"MohsinElis/mfft-checkpoints\",\n",
    "            filename=base_runs[-1], repo_type=\"model\", token=hf_token,\n",
    "        )\n",
    "        ckpt = torch.load(path, map_location=device)\n",
    "        model.load_state_dict(ckpt[\"model_state_dict\"])\n",
    "        print(f\"Loaded fallback checkpoint: {base_runs[-1]}\")\n",
    "    else:\n",
    "        raise RuntimeError(\"No MFFT-base checkpoint found on HF. Run train_mfft_base.ipynb first.\")\n",
    "\n",
    "model.eval()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 5: Collect test predictions\n",
    "all_logits, all_labels = [], []\n",
    "with torch.no_grad():\n",
    "    for imgs, labels in test_loader:\n",
    "        imgs = imgs.to(device)\n",
    "        logits = model(imgs)\n",
    "        all_logits.append(logits.cpu())\n",
    "        all_labels.append(labels)\n",
    "\n",
    "all_logits = torch.cat(all_logits)\n",
    "all_labels = torch.cat(all_labels)\n",
    "all_probs = F.softmax(all_logits, dim=1).numpy()\n",
    "all_preds = all_logits.argmax(1).numpy()\n",
    "y_true = all_labels.numpy()\n",
    "print(f\"Test samples: {len(y_true)}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 6: Bootstrap 95% Confidence Intervals\n",
    "from sklearn.metrics import f1_score, accuracy_score, roc_auc_score\n",
    "\n",
    "def bootstrap_ci(y_true, y_pred, y_prob, n_bootstrap=1000, ci=0.95):\n",
    "    \"\"\"Bootstrap confidence intervals for accuracy, F1, AUC.\"\"\"\n",
    "    rng = np.random.RandomState(42)\n",
    "    n = len(y_true)\n",
    "    accs, f1s, aucs = [], [], []\n",
    "    for _ in range(n_bootstrap):\n",
    "        idx = rng.choice(n, n, replace=True)\n",
    "        accs.append(accuracy_score(y_true[idx], y_pred[idx]))\n",
    "        f1s.append(f1_score(y_true[idx], y_pred[idx], average=\"macro\", zero_division=0))\n",
    "        try:\n",
    "            aucs.append(roc_auc_score(y_true[idx], y_prob[idx], multi_class=\"ovr\", average=\"macro\"))\n",
    "        except Exception:\n",
    "            aucs.append(0)\n",
    "    alpha = (1 - ci) / 2\n",
    "    return {\n",
    "        \"accuracy\": (np.percentile(accs, alpha*100), np.percentile(accs, (1-alpha)*100), np.mean(accs)),\n",
    "        \"macro_f1\": (np.percentile(f1s, alpha*100), np.percentile(f1s, (1-alpha)*100), np.mean(f1s)),\n",
    "        \"auc\": (np.percentile(aucs, alpha*100), np.percentile(aucs, (1-alpha)*100), np.mean(aucs)),\n",
    "    }\n",
    "\n",
    "ci_results = bootstrap_ci(y_true, all_preds, all_probs)\n",
    "print(\"\\n=== Bootstrap 95% Confidence Intervals ===\")\n",
    "for metric, (lo, hi, mean) in ci_results.items():\n",
    "    print(f\"  {metric}: {mean:.4f} [{lo:.4f}, {hi:.4f}]\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 7: Temperature Scaling (Calibration)\n",
    "from src.calibration import TemperatureScaler, expected_calibration_error\n",
    "\n",
    "# Fit on validation logits\n",
    "val_logits, val_labels = [], []\n",
    "with torch.no_grad():\n",
    "    for imgs, labels in val_loader:\n",
    "        imgs = imgs.to(device)\n",
    "        logits = model(imgs)\n",
    "        val_logits.append(logits.cpu())\n",
    "        val_labels.append(labels)\n",
    "val_logits = torch.cat(val_logits)\n",
    "val_labels = torch.cat(val_labels)\n",
    "\n",
    "scaler = TemperatureScaler()\n",
    "T = scaler.fit(val_logits, val_labels)\n",
    "print(f\"Fitted temperature: {T:.4f}\")\n",
    "\n",
    "# Pre-calibration metrics\n",
    "pre_probs = F.softmax(all_logits, dim=1).numpy()\n",
    "pre_ece = expected_calibration_error(y_true, pre_probs)\n",
    "\n",
    "# Post-calibration metrics\n",
    "calibrated_logits = scaler.calibrate(all_logits)\n",
    "post_probs = F.softmax(calibrated_logits, dim=1).numpy()\n",
    "post_ece = expected_calibration_error(y_true, post_probs)\n",
    "\n",
    "# Brier score\n",
    "from sklearn.metrics import brier_score_loss\n",
    "pre_brier = np.mean([brier_score_loss((y_true == c).astype(float), pre_probs[:, c]) for c in range(3)])\n",
    "post_brier = np.mean([brier_score_loss((y_true == c).astype(float), post_probs[:, c]) for c in range(3)])\n",
    "\n",
    "print(f\"\\n=== Calibration ===\")\n",
    "print(f\"  Pre-calibration  ECE: {pre_ece:.4f} | Brier: {pre_brier:.4f}\")\n",
    "print(f\"  Post-calibration ECE: {post_ece:.4f} | Brier: {post_brier:.4f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 8: Robustness suite\n",
    "import io\n",
    "from PIL import Image, ImageFilter\n",
    "\n",
    "def evaluate_under_perturbation(model, loader, device, perturb_fn, name):\n",
    "    model.eval()\n",
    "    all_p, all_l = [], []\n",
    "    with torch.no_grad():\n",
    "        for entry in loader.dataset.entries:\n",
    "            img = Image.open(entry[\"path\"]).convert(\"RGB\")\n",
    "            img = perturb_fn(img)\n",
    "            from torchvision import transforms\n",
    "            t = transforms.Compose([\n",
    "                transforms.Resize((224, 224)), transforms.ToTensor(),\n",
    "                transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),\n",
    "            ])\n",
    "            tensor = t(img).unsqueeze(0).to(device)\n",
    "            logits = model(tensor)\n",
    "            all_p.append(logits.argmax(1).item())\n",
    "            all_l.append(entry[\"label_int\"])\n",
    "    acc = accuracy_score(all_l, all_p)\n",
    "    f1 = f1_score(all_l, all_p, average=\"macro\", zero_division=0)\n",
    "    print(f\"  {name:20s} acc={acc:.4f} f1={f1:.4f}\")\n",
    "    return {\"name\": name, \"acc\": acc, \"f1\": f1}\n",
    "\n",
    "# Only run on a subset for speed\n",
    "subset_entries = loader.test_data[:200]\n",
    "from kaggle_dataset_loader import ManifestDataset, VAL_TRANSFORM\n",
    "subset_ds = ManifestDataset(subset_entries, transform=VAL_TRANSFORM)\n",
    "subset_loader = torch.utils.data.DataLoader(subset_ds, batch_size=64)\n",
    "\n",
    "print(\"\\n=== Robustness Suite ===\")\n",
    "rob_results = []\n",
    "rob_results.append(evaluate_under_perturbation(model, subset_loader, device, lambda x: x, \"clean\"))\n",
    "rob_results.append(evaluate_under_perturbation(model, subset_loader, device, lambda x: x.resize((112,112)).resize((224,224)), \"downscale_0.5x\"))\n",
    "rob_results.append(evaluate_under_perturbation(model, subset_loader, device, lambda x: x.filter(ImageFilter.GaussianBlur(2)), \"blur_sigma2\"))\n",
    "\n",
    "def jpeg_perturb(x, q=50):\n",
    "    buf = io.BytesIO()\n",
    "    x.save(buf, format=\"JPEG\", quality=q)\n",
    "    buf.seek(0)\n",
    "    return Image.open(buf).convert(\"RGB\")\n",
    "rob_results.append(evaluate_under_perturbation(model, subset_loader, device, lambda x: jpeg_perturb(x, 50), \"jpeg_q50\"))\n",
    "rob_results.append(evaluate_under_perturbation(model, subset_loader, device, lambda x: jpeg_perturb(x, 10), \"jpeg_q10\"))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 9: Save all results\n",
    "results = {\n",
    "    \"manifest_sha256\": manifest_sha256[:16],\n",
    "    \"test_samples\": len(y_true),\n",
    "    \"bootstrap_ci\": {k: {\"mean\": float(v[2]), \"lo\": float(v[0]), \"hi\": float(v[1])} for k, v in ci_results.items()},\n",
    "    \"calibration\": {\n",
    "        \"temperature\": T,\n",
    "        \"pre_ece\": pre_ece, \"post_ece\": post_ece,\n",
    "        \"pre_brier\": pre_brier, \"post_brier\": post_brier,\n",
    "    },\n",
    "    \"robustness\": rob_results,\n",
    "}\n",
    "\n",
    "out_dir = Path(\"/kaggle/working/paper_eval_results\")\n",
    "out_dir.mkdir(exist_ok=True)\n",
    "with open(out_dir / \"paper_evals.json\", \"w\") as f:\n",
    "    json.dump(results, f, indent=2, default=str)\n",
    "\n",
    "# Upload to HF\n",
    "from huggingface_hub import HfApi\n",
    "api = HfApi(token=hf_token)\n",
    "api.upload_file(\n",
    "    path_or_fileobj=str(out_dir / \"paper_evals.json\"),\n",
    "    path_in_repo=\"results/paper_evals.json\",\n",
    "    repo_id=\"MohsinElis/mfft-checkpoints\", repo_type=\"model\",\n",
    ")\n",
    "print(\"\\nAll results saved and uploaded.\")"
   ]
  }
